{
  "name": "driver-off-duty-remotion-captions",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts --no-open",
    "render": "remotion render src/index.ts DriverOffDutyCaptions output/driver-off-duty-caption-effects.mp4 --codec=h264 --crf=17 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=192k"
  },
  "dependencies": {
    "@remotion/cli": "4.0.506",
    "@remotion/media": "4.0.506",
    "@remotion/renderer": "4.0.506",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.506"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
